rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PUBLIC READS ────────────────────────────────────
    // All public pages need to read content
    match /{document=**} {
      allow read: if true;
    }

    // ── PUBLIC WRITES (no login required) ───────────────
    // Newsletter subscription form on home page
    match /newsletter/{docId} {
      allow write: if true;
    }

    // Contact / enquiry form
    match /contacts/{docId} {
      allow write: if true;
    }

    // Event registration form
    match /registrations/{docId} {
      allow write: if true;
    }

    // Student attendance marking (QR / code entry)
    match /attendance_records/{docId} {
      allow write: if true;
    }

    // Event feedback form (public page)
    match /feedback/{docId} {
      allow write: if true;
    }

    // Quiz answers submitted by students
    match /quiz_answers/{docId} {
      allow write: if true;
    }

    // ── ADMIN WRITES (login required) ───────────────────
    // All other collections require the user to be signed in
    match /{document=**} {
      allow write: if request.auth != null;
    }
  }
}
